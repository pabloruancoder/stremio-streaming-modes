# Copie este arquivo para ".env" e preencha.

# Chave do TMDB (grátis em https://www.themoviedb.org/settings/api).
# Use UMA das duas: a "Chave da API" (v3) ou o "Token de leitura" (v4).
TMDB_API_KEY=
TMDB_READ_TOKEN=

# País dos catálogos e do Top 10 (código ISO de 2 letras) e idioma dos títulos/sinopses.
REGION=BR
LANGUAGE=pt-BR

# Porta do servidor local do addon.
PORT=7100

# Formato dos cards das fileiras "em alta"/gêneros: landscape (estilo Netflix) ou poster.
CARD_STYLE=landscape
